  "settings": {
    "java.project": {
      "title": "Java source project (JSON) / Java 源码项目（JSON）",
      "value_type": {
        "kind": "string",
        "max_length": 4096
      },
      "default": "{}",
      "scope": "project"
    },
    "java.runtime": {
      "title": "Language runtime java executable / 语言服务 Java 可执行文件",
      "value_type": {
        "kind": "string",
        "max_length": 4096
      },
      "default": "",
      "scope": "user"
    },
    "java.jdkHome": {
      "title": "Local project JDK directory / 项目本机 JDK 目录",
      "value_type": {
        "kind": "string",
        "max_length": 4096
      },
      "default": "",
      "scope": "project"
    },
    "java.jdkVersion": {
      "title": "Project JDK version / 项目 JDK 版本",
      "value_type": {
        "kind": "enum",
        "choices": [
          "8",
          "11",
          "17",
          "21",
          "25"
        ]
      },
      "default": "25",
      "scope": "project"
    }
  },
